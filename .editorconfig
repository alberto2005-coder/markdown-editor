# Estilo uniforme para quien contribuya al proyecto
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# En Markdown dos espacios finales = salto de línea
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
